# Pesos YOLO. yolov8n.pt sirve para probar; para producción usar el modelo entrenado con cajas.
MODELO=yolov8n.pt
# Clases a contar (nombres del modelo separados por coma). Vacío = todas.
CLASES=
# Confianza mínima de una detección (0 a 1)
CONFIANZA_MIN=0.4
# Fuente de video: índice de cámara (0), ruta a un video o URL RTSP
FUENTE=0

# Línea de conteo horizontal, como fracción del alto del cuadro (0 = arriba, 1 = abajo).
# Cruzar de arriba hacia abajo = entrada; de abajo hacia arriba = salida.
LINEA_Y=0.5
ZONA=A

# API de movimientos (HU-09)
VISION_API_URL=http://localhost:3000/api/movimientos
VISION_API_KEY=
