{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "visiostock.vercel.app"
        }
      ],
      "destination": "https://visiostock-mia.vercel.app/:path*",
      "permanent": false
    }
  ]
}
